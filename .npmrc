# P2 (ditemukan saat migrasi Auth.js v5): next-auth@5 mendeklarasikan
# peerOptional nodemailer ^7 || ^8, sementara root memakai ^9.
# Peer tersebut tak pernah dipakai runtime (hanya Credentials provider),
# tapi npm strict (termasuk `npm install` di Vercel) gagal ERESOLVE
# tanpanya. Opsi yang ditolak: downgrade nodemailer (mundur dari patch
# keamanan tanpa manfaat). Lihat hasil eksekusi TASK-P1.
legacy-peer-deps=true
