# ============================================================
# Salin isi file ini ke file bernama .env di root project kamu
# ============================================================

# DATABASE — Supabase
# Ambil dari: Project Settings → Database → Connection string
# Pilih mode "Transaction" (port 6543) untuk Vercel/serverless
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL untuk prisma migrate (pakai port 5432, bukan pooler)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# AUTH — Auth.js v5 (next-auth@5), JWT + Credentials
# trustHost sudah true di lib/auth.ts — tidak perlu AUTH_TRUST_HOST.
# Generate secret baru di terminal: openssl rand -base64 32
# (JWT di-sign ulang + prefix cookie berubah next-auth.* → authjs.*).
AUTH_SECRET="ganti-dengan-string-random-minimal-32-karakter"

# PUBLIC SITE URL — WAJIB untuk Open Graph, JSON-LD, canonical, sitemap, robots
# Domain production yang akan di-crawl. NEXT_PUBLIC_* = exposed ke client.
NEXT_PUBLIC_SITE_URL="https://your-site-domain"

# SMTP EMAIL — Gmail
# Aktifkan 2FA dulu, lalu buat App Password di:
# myaccount.google.com → Security → App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="emaildesa@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Desa Sukobubuk <emaildesa@gmail.com>"

# CLOUDINARY
# Ambil dari: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="nama-cloud-kamu"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxx"

# VERIFICATION (opsional) — untuk Google Search Console / Bing 
# Kosongkan jika tidak pakai; app/layout.tsx hanya emit meta jika terisi
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# OBSERVABILITAS DEV (opsional) — T-50
# 1 = log tiap query Prisma + timing ms per query (`[db-timing] Model.aksi`).
# Default mati agar dev log bersih. Tidak berpengaruh ke production
# (`console.info` dibuang `compiler.removeConsole` di next.config.ts).
# DEBUG_PRISMA="1"