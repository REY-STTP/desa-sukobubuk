# ============================================================
# Salin isi file ini ke file bernama .env.local di root project kamu
# ============================================================

# DATABASE — Supabase
# Ambil dari: Project Settings → Database → Connection string
# Pilih mode "Transaction" (port 6543) untuk Vercel/serverless
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL untuk prisma migrate (pakai port 5432, bukan pooler)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NEXTAUTH
# Generate secret baru di terminal: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-random-minimal-32-karakter"
NEXTAUTH_URL="https://desa-sukobubuk.id"

# SMTP EMAIL — Gmail
# Aktifkan 2FA dulu, lalu buat App Password di:
# myaccount.google.com → Security → App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="emaildesa@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Desa Sukobubuk <emaildesa@gmail.com>"

# CLOUDINARY
# Ambil dari: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="nama-cloud-kamu"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxx"